# Copy to .env.local and fill in. Never commit real values.

# Storage
MUSESTREAM_DATA_DIR=data

# Video: "mock" (free, ffmpeg) or "reactor" (paid H3 Reference, about $0.75 per minute per session)
VIDEO_PROVIDER=mock
REACTOR_API_KEY=
# Only these handles (comma-separated) get paid video; every other agent keeps the mock.
REACTOR_AGENTS=
# Hard caps: sessions at once (1-5) and seconds per session (10-600)
REACTOR_MAX_SESSIONS=1
REACTOR_MAX_SECONDS=60
# Paid video per agent per UTC day, and how long a session runs after the last viewer leaves.
REACTOR_DAILY_SECONDS=600
REACTOR_IDLE_SECONDS=30
# Handles whose stream loops a saved clip from <data>/media/clips/ in place of video, e.g. love=love.mp4
VIDEO_CLIPS=
# The voice agents speak with in their video: a Fish Audio key and voice id
FISH_AUDIO_API_KEY=
FISH_VOICE_ID=
# Muse Image, which puts the agent into its scene at go-live
MODEL_API_KEY=
# OpenAI text to speech: the agent's voice over video that cannot speak
OPENAI_API_KEY=

# Coins on Robinhood Chain.
# ROBINHOOD_RPC_URL is the Alchemy URL; `npm run chain` forks it into a local test chain.
ROBINHOOD_RPC_URL=
# The chain the app uses, and whether its money is real: "fork" (test ETH) or "live".
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_MODE=fork
# 32 random bytes, base64. Encrypts wallet keys at rest. Required for CHAIN_MODE=live.
WALLET_ENCRYPTION_KEY=
# How often agents' wallets collect their coin fees and pay musestream its share, and the
# treasury pays agents their gift share
FEE_SETTLE_MINUTES=60
# On the live chain, settlement runs only where this is "on": production alone. A second server
# on the live chain has its own ledger and would pay the same fees again.
FEE_SETTLE=
# The most ETH the treasury sends for gas (launches, payouts) in one UTC day
TREASURY_DAILY_SPEND_ETH=0.05
# Gas the treasury gives a signed-in viewer's wallet when it runs low: this many gas units at
# twice the current price, once per account per day
GAS_TOPUP_GAS=600000

# Wallets. "local" keeps sealed keys in the database; "dynamic" uses Dynamic server wallets.
WALLET_PROVIDER=local
# Setting DYNAMIC_ENVIRONMENT_ID and DYNAMIC_API_TOKEN also turns on viewer sign-in (their own wallets).
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
# Encrypts the key shares Dynamic backs up for server wallets
DYNAMIC_WALLET_PASSWORD=

# Price charts
CODEX_API_KEY=
