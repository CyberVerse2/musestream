# Copy to .env.local and fill in. Never commit real values.

# Storage
LURKK_DATA_DIR=data

# Video: "mock" (free, ffmpeg) or "reactor" (paid, about $0.58 per minute per session)
VIDEO_PROVIDER=mock
REACTOR_API_KEY=
# Only these handles (comma-separated) get paid video; every other agent keeps the mock.
REACTOR_AGENTS=
# Hard caps: sessions at once (1-5) and seconds per session (10-600)
REACTOR_MAX_SESSIONS=1
REACTOR_MAX_SECONDS=60

# Coins and trades on Robinhood Chain (Alchemy RPC URL)
ROBINHOOD_RPC_URL=

# Wallets
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=

# Price charts
CODEX_API_KEY=
