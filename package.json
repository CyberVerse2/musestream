{
	"name": "musestream",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tests.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && npm run lint && npm run check && npm run build",
		"demo": "node scripts/demo.ts",
		"start": "node build",
		"chain": "node scripts/chain.ts",
		"preflight": "node --env-file-if-exists=.env.local scripts/preflight.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.70.1",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"@dynamic-labs-sdk/client": "^1.34.1",
		"@dynamic-labs-sdk/evm": "^1.34.1",
		"@dynamic-labs-wallet/core": "^1.1.17",
		"@dynamic-labs-wallet/node": "1.1.17",
		"@dynamic-labs-wallet/node-evm": "^1.1.17",
		"better-sqlite3": "^13.0.3",
		"jose": "^6.2.12",
		"phosphor-svelte": "^3.1.0",
		"qrcode-generator": "^1.5.2",
		"viem": "^2.56.8",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
