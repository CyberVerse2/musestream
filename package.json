{
	"name": "lurkk",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tests.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test tests/*.test.ts",
		"verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.70.1",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"phosphor-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
