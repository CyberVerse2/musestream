{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"]
	},
	"include": ["shared/**/*.ts", "tests/**/*.ts"]
}
