{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"]
	},
	"include": ["shared/**/*.ts", "src/lib/server/**/*.ts", "scripts/**/*.ts"],
	"exclude": [
		"src/lib/server/app.ts",
		"src/lib/server/market.ts",
		"src/lib/server/viewer.ts",
		"src/lib/server/chain/dynamic-wallets.ts",
		"src/lib/server/session.ts"
	]
}
